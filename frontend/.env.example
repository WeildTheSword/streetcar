# Base URL of the backend API, with no trailing slash. Vite bakes it into the
# bundle at build time, so changing it means rebuilding.
# Local dev: the Spring Boot app on :8080 (also the fallback when unset).
# Vercel: set it in Project Settings > Environment Variables to the Render URL,
# for example https://streetcar-backend.onrender.com, then redeploy.
VITE_API_URL=http://localhost:8080
