<mxfile host="app.diagrams.net"><diagram id="streetcar-classes" name="Class Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2610" pageHeight="2370" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="StreetCar — class diagram (backend, com.streetcar.backend)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1200" height="28" as="geometry"/></mxCell><mxCell id="v2" value="«controller» — 10 @RestControllers, grouped (methods omitted). Each reads the caller as @AuthenticationPrincipal AuthenticatedUser." style="swimlane;fontStyle=1;startSize=30;html=0;whiteSpace=wrap;fillColor=#e8dcc0;swimlaneFillColor=#fbf8f0;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="330" as="geometry"/></mxCell><mxCell id="v3" value="&lt;table style=&quot;font-size:12px;border-collapse:collapse;width:100%&quot;&gt;&lt;th style=&quot;text-align:left;padding:3px 8px;border-bottom:1px solid #888;width:190px&quot;&gt;Controller&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 8px;border-bottom:1px solid #888;width:600px&quot;&gt;Endpoints&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 8px;border-bottom:1px solid #888;width:330px&quot;&gt;Calls&lt;/th&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top&quot;&gt;&lt;b&gt;AuthController&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top&quot;&gt;POST /auth/login, /auth/signup, /auth/reset&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top&quot;&gt;AuthService, DemoResetService&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f4efe2&quot;&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top&quot;&gt;&lt;b&gt;SubmissionController&lt;/b&gt;&lt;/td&gt;&lt;td