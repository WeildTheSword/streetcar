<mxfile host="app.diagrams.net"><diagram id="sequence-diagram" name="Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="2130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="StreetCar — sequence diagrams: signing in, then an authenticated request" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1400" height="28" as="geometry"/></mxCell><mxCell id="v2" value="sd 1 — Sign in: POST /auth/login" style="shape=umlFrame;whiteSpace=wrap;html=0;width=560;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=none;fontStyle=1;fontSize=13;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1960" height="870" as="geometry"/></mxCell><mxCell id="v3" value="Browser&#10;(LoginPage, AuthProvider,&#10;httpClient.js)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="210" height="802" as="geometry"/></mxCell><mxCell id="v4" value="AuthController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="345" y="100" width="210" height="802" as="geometry"/></mxCell><mxCell id="v5" value="AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="635" y="100" width="210" height="802" as="geometry"/></mxCell><mxCell id="v6" value="UserRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="100" width="210" height="802" as="geometry"/></mxCell><mxCell id="v7" value="PasswordEncoder&#10;(BCrypt)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1215" y="100" width="210" height="802" as="geometry"/></mxCell><mxCell id="v8" value="JwtIssuer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1505" y="100" width="210" height="802" as="geometry"/></mxCell><mxCell id="v9" value="SecurityConfig permits /auth/** without a token,&#10;so the request reaches the controller as is." style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff9db;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="166" width="290" height="40" as="geometry"/></mxCell><mxCell id="e10" value="POST /auth/login {email, password}" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="240" as="sourcePoint"/><mxPoint x="450" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" value="signIn(request)" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="276" as="sourcePoint"/><mxPoint x="740" y="276" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="findByEmail(email.trim().toLowerCase())" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="312" as="sourcePoint"/><mxPoint x="1030" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e13" value="Optional&lt;User&gt;" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="348" as="sourcePoint"/><mxPoint x="740" y="348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v14" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=0;width=56;height=22;boundedLbl=1;verticalAlign=middle;align=center;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="370" width="780" height="92" as="geometry"/></mxCell><mxCell id="v15" value="[a user has that email]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="764" y="373" width="700" height="18" as="geometry"/></mxCell><mxCell id="e16" value="matches(password, user.passwordHash)" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="410" as="sourcePoint"/><mxPoint x="1320" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="boolean" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="444" as="sourcePoint"/><mxPoint x="740" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v18" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=0;width=56;height=22;boundedLbl=1;verticalAlign=middle;align=center;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="1920" height="402" as="geometry"/></mxCell><mxCell id="v19" value="[a user was found and the password matches]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="104" y="487" width="1840" height="18" as="geometry"/></mxCell><mxCell id="e20" value="issue(user)" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="528" as="sourcePoint"/><mxPoint x="1610" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v21" value="HS256, signed with JWT_SECRET&#10;sub = user id, role = STUDENT | ADVISOR | ALUMNI&#10;iat = now, exp = now + 8 hours" style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff9db;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="534" width="300" height="54" as="geometry"/></mxCell><mxCell id="e22" value="token (compact JWT)" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="580" as="sourcePoint"/><mxPoint x="740" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e23" value="startSession(user): AuthResponse" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;align=left;spacingLeft=4;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="606" as="sourcePoint"/><mxPoint x="741" y="628" as="targetPoint"/><Array as="points"><mxPoint x="776" y="606"/><mxPoint x="776" y="628"/></Array></mxGeometry></mxCell><mxCell id="e24" value="Optional&lt;AuthResponse&gt;" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="660" as="sourcePoint"/><mxPoint x="450" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="200 OK  AuthResponse {token, role, ...}" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="700" as="sourcePoint"/><mxPoint x="150" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="setAuthToken(token); AuthResponse also carries profileId, displayName, initials, subtitle, onboarded.&#10;Every later request sends Authorization: Bearer &lt;token&gt;." style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;align=left;spacingLeft=4;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="726" as="sourcePoint"/><mxPoint x="151" y="748" as="targetPoint"/><Array as="points"><mxPoint x="186" y="726"/><mxPoint x="186" y="748"/></Array></mxGeometry></mxCell><mxCell id="e27" value="" style="endArrow=none;dashed=1;html=0;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="776" as="sourcePoint"/><mxPoint x="1960" y="776" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v28" value="[else: no user with that email, or the password does not match]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="779" width="1900" height="18" as="geometry"/></mxCell><mxCell id="e29" value="Optional.empty()" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="826" as="sourcePoint"/><mxPoint x="450" y="826" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e30" value="401 Unauthorized (empty body)" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;fontColor=#a1192b;strokeColor=#a1192b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="862" as="sourcePoint"/><mxPoint x="150" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v31" value="sd 2 — Authenticated request: an advisor's DELETE /submissions/{id}" style="shape=umlFrame;whiteSpace=wrap;html=0;width=560;height=26;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=none;fontStyle=1;fontSize=13;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="966" width="1960" height="1124" as="geometry"/></mxCell><mxCell id="v32" value="Browser&#10;(SubmissionsPage,&#10;httpClient.js)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="1010" width="210" height="1056" as="geometry"/></mxCell><mxCell id="v33" value="JwtAuthentication&#10;Filter" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="1010" width="210" height="1056" as="geometry"/></mxCell><mxCell id="v34" value="JwtVerifier" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="1010" width="210" height="1056" as="geometry"/></mxCell><mxCell id="v35" value="SecurityConfig&#10;(authorizeHttpRequests)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875" y="1010" width="210" height="1056" as="geometry"/></mxCell><mxCell id="v36" value="SubmissionController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1155" y="1010" width="210" height="1056" as="geometry"/></mxCell><mxCell id="v37" value="SubmissionService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1425" y="1010" width="210" height="1056" as="geometry"/></mxCell><mxCell id="v38" value="SubmissionRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=58;fillColor=#e8dcc0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1685" y="1010" width="210" height="1056" as="geometry"/></mxCell><mxCell id="e39" value="DELETE /submissions/42&#10;Authorization: Bearer &lt;token&gt;" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1110" as="sourcePoint"/><mxPoint x="430" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v40" value="No header, or not &quot;Bearer &quot;:&#10;verify is skipped and the&#10;request stays anonymous." style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff9db;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="1150" width="200" height="54" as="geometry"/></mxCell><mxCell id="v41" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=0;width=56;height=22;boundedLbl=1;verticalAlign=middle;align=center;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="1132" width="610" height="170" as="geometry"/></mxCell><mxCell id="v42" value="[Authorization header starts with &quot;Bearer &quot;]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="454" y="1135" width="530" height="18" as="geometry"/></mxCell><mxCell id="e43" value="verify(token)" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="1176" as="sourcePoint"/><mxPoint x="700" y="1176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v44" value="Checks the HS256 signature with JWT_SECRET,&#10;the expiry, and that sub and role are present.&#10;Any failure returns Optional.empty()." style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff9db;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="1188" width="280" height="52" as="geometry"/></mxCell><mxCell id="e45" value="Optional&lt;AuthenticatedUser&gt;" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1248" as="sourcePoint"/><mxPoint x="430" y="1248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e46" value="if present: SecurityContext.setAuthentication(user, ROLE_&lt;role&gt;)" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;align=left;spacingLeft=4;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="1270" as="sourcePoint"/><mxPoint x="431" y="1292" as="targetPoint"/><Array as="points"><mxPoint x="466" y="1270"/><mxPoint x="466" y="1292"/></Array></mxGeometry></mxCell><mxCell id="e47" value="chain.doFilter(request, response)" style="html=0;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="1336" as="sourcePoint"/><mxPoint x="980" y="1336" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v48" value="DELETE /submissions/** -&gt; hasRole(ADVISOR)&#10;/advisor/** -&gt; hasRole(ADVISOR), e.g. GET /advisor/students&#10;takes the same path and alternatives." style="shape=note;size=14;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff9db;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="1344" width="330" height="52" as="geometry"/></mxCell><mxCell id="v49" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=0;width=56;height=22;boundedLbl=1;verticalAlign=middle;align=center;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1412" width="1920" height="638" as="geometry"/></mxCell><mxCell id="v50" value="[no valid token: the request is anonymous]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="104" y="1415" width="1840" height="18" as="geometry"/></mxCell><mxCell id="e51" value="401 {&quot;message&quot;: &quot;Please sign in to continue.&quot;}   (authenticationEntryPoint)" style="html=0;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;fontColor=#a1192b;strokeColor=#a1192b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="1458" as