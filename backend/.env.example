# Local demo only. Export these in your shell; Spring does not load .env files.
DB_URL=jdbc:h2:file:./data/streetcar
DB_USERNAME=sa
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
# Required: the backend will not start without it. Signs and checks sign-in tokens.
# Generate your own with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
