# Local demo only. Export these in your shell; Spring does not load .env files.
# With none of the DB_ variables set, the backend uses a local H2 file database.
DB_URL=jdbc:h2:file:./data/streetcar
DB_USERNAME=sa
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
# Required: the backend will not start without it. Signs and checks sign-in tokens.
# Generate your own with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# Supabase PostgreSQL. In the Supabase dashboard, open Connect and copy the
# Session pooler string (the direct connection is IPv6 only). Turn it into a
# JDBC URL and keep the user and password out of it. Placeholders only: never
# commit the real values.
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database-password>
